{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,

    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "resolveJsonModule": true,

    "ignoreDeprecations": "6.0",
    "noEmit": true
  },

  "include": ["src"],
  "exclude": ["backend"]
}